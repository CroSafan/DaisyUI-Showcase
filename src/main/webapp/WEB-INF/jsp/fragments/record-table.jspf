<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<section class="card panel-card">
  <div class="panel-head">
    <div>
      <span class="section-kicker">LIVE PREVIEW</span>
      <h2><c:out value="${demo.tableTitle}"/></h2>
    </div>
    <button class="btn btn-primary btn-sm" type="button" data-toast="This is a showcase action">
      <c:out value="${demo.primaryAction}"/>
      <span aria-hidden="true">↗</span>
    </button>
  </div>
  <div class="table-wrap">
    <table class="table table-zebra">
      <thead>
        <tr>
          <th scope="col">Name / reference</th>
          <th scope="col">Owner</th>
          <th scope="col">Status</th>
          <th scope="col">Value / timing</th>
          <th scope="col"><span class="sr-only">Action</span></th>
        </tr>
      </thead>
      <tbody>
        <c:forEach items="${demo.records}" var="record">
          <tr>
            <td><strong><c:out value="${record.name}"/></strong><small><c:out value="${record.detail}"/></small></td>
            <td><c:out value="${record.owner}"/></td>
            <td><span class="badge badge-${record.tone} badge-soft"><c:out value="${record.status}"/></span></td>
            <td class="mono"><c:out value="${record.value}"/></td>
            <td>
              <button class="btn btn-ghost btn-xs" type="button" data-detail="${fn:escapeXml(record.name)}" aria-label="View ${fn:escapeXml(record.name)}">
                View ↗
              </button>
            </td>
          </tr>
        </c:forEach>
      </tbody>
    </table>
  </div>
</section>
