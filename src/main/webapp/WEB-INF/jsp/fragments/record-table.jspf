<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<spring:message code="ui.1124" var="msg_ui_1124"/>
<section class="card panel-card">
  <div class="panel-head">
    <div>
      <span class="section-kicker"><spring:message code="ui.541"/></span>
      <h2><spring:message code="${messageCodes[demo.tableTitle]}" text="${demo.tableTitle}" htmlEscape="true"/></h2>
    </div>
    <button class="btn btn-primary btn-sm" type="button" data-toast="${msg_ui_1124}">
      <spring:message code="${messageCodes[demo.primaryAction]}" text="${demo.primaryAction}" htmlEscape="true"/>
      <span aria-hidden="true">↗</span>
    </button>
  </div>
  <div class="table-wrap">
    <table class="table table-zebra">
      <thead>
        <tr>
          <th scope="col"><spring:message code="ui.542"/></th>
          <th scope="col"><spring:message code="ui.361"/></th>
          <th scope="col"><spring:message code="ui.092"/></th>
          <th scope="col"><spring:message code="ui.544"/></th>
          <th scope="col"><span class="sr-only"><spring:message code="ui.264"/></span></th>
        </tr>
      </thead>
      <tbody>
        <c:forEach items="${demo.records}" var="record">
          <tr>
            <td><strong><spring:message code="${messageCodes[record.name]}" text="${record.name}" htmlEscape="true"/></strong><small><spring:message code="${messageCodes[record.detail]}" text="${record.detail}" htmlEscape="true"/></small></td>
            <td><spring:message code="${messageCodes[record.owner]}" text="${record.owner}" htmlEscape="true"/></td>
            <td><span class="badge badge-${record.tone} badge-soft"><spring:message code="${messageCodes[record.status]}" text="${record.status}" htmlEscape="true"/></span></td>
            <td class="mono"><spring:message code="${messageCodes[record.value]}" text="${record.value}" htmlEscape="true"/></td>
            <td>
              <button class="btn btn-ghost btn-xs" type="button" data-detail="${fn:escapeXml(record.name)}" aria-label="View ${fn:escapeXml(record.name)}">
                <spring:message code="ui.845"/>
              </button>
            </td>
          </tr>
        </c:forEach>
      </tbody>
    </table>
  </div>
</section>
