<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<div class="metric-grid">
  <c:forEach items="${demo.metrics}" var="metric">
    <article class="card metric-card">
      <div class="card-body">
        <div class="metric-top">
          <span><spring:message code="${messageCodes[metric.label]}" text="${metric.label}" htmlEscape="true"/></span>
          <span class="metric-spark" aria-hidden="true">↗</span>
        </div>
        <strong class="metric-value"><spring:message code="${messageCodes[metric.value]}" text="${metric.value}" htmlEscape="true"/></strong>
        <span class="badge badge-${metric.tone} badge-soft"><spring:message code="${messageCodes[metric.change]}" text="${metric.change}" htmlEscape="true"/></span>
      </div>
    </article>
  </c:forEach>
</div>
