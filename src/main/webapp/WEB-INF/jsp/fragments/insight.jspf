<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<aside class="card insight-card">
  <div class="card-body">
    <span class="section-kicker"><spring:message code="ui.842"/></span>
    <h2><spring:message code="${messageCodes[demo.insightTitle]}" text="${demo.insightTitle}" htmlEscape="true"/></h2>
    <p><spring:message code="${messageCodes[demo.insightBody]}" text="${demo.insightBody}" htmlEscape="true"/></p>
    <div class="insight-progress">
      <div><span><spring:message code="ui.843"/></span><strong>${demo.progress}%</strong></div>
      <progress class="progress progress-primary" value="${demo.progress}" max="100" aria-label="Overall progress ${demo.progress} percent">
      </progress>
    </div>
    <div class="insight-foot"><span class="status-dot"></span><spring:message code="ui.844"/> <span aria-hidden="true">↗</span></div>
  </div>
</aside>
