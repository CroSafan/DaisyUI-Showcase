<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<div class="time-context">
  <div>
    <span class="time-context-icon" aria-hidden="true">◷</span>
    <span>
      <strong>ATLAS / PEOPLE OPERATIONS</strong>
      <small>Time & attendance workspace · Fictional demonstration data</small>
    </span>
  </div>
  <span class="badge badge-outline">September 2026 scenario</span>
</div>
<nav class="time-subnav" aria-label="Time management pages">
  <c:forEach items="${timeNavigation}" var="item" varStatus="loop">
    <a class="time-subnav-link ${current.slug eq item.slug ? 'active' : ''}" href="${pageContext.request.contextPath}${item.path}" ${current.slug eq item.slug ? 'aria-current="page"' : ''}>
      <span class="time-nav-number"><c:if test="${loop.count lt 10}">0</c:if>${loop.count}</span>
      <c:out value="${item.title}"/>
    </a>
  </c:forEach>
</nav>
<c:if test="${not empty notice}">
  <div class="alert alert-success time-message" role="status">✓ <c:out value="${notice}"/></div>
</c:if>
<c:if test="${not empty error}">
  <div class="alert alert-error time-message" role="alert">⚠ <c:out value="${error}"/></div>
</c:if>
