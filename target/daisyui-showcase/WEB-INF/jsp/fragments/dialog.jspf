<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<dialog id="detail-dialog" class="modal" aria-labelledby="dialog-title">
  <div class="modal-box">
    <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost modal-close" aria-label="Close dialog">✕</button>
    </form>
    <span class="section-kicker">RECORD DETAIL</span>
    <h2 id="dialog-title">Record details</h2>
    <p>This representative detail panel shows how a DaisyUI dialog can sit alongside a server-rendered workflow.</p>
    <div class="alert alert-info"><span id="dialog-record">Selected record</span></div>
    <div class="modal-action">
      <form method="dialog"><button class="btn btn-primary">Done</button></form>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button aria-label="Close dialog">close</button></form>
</dialog>
