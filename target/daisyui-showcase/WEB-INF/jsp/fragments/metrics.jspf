<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<div class="metric-grid">
  <c:forEach items="${demo.metrics}" var="metric">
    <article class="card metric-card">
      <div class="card-body">
        <div class="metric-top">
          <span><c:out value="${metric.label}"/></span>
          <span class="metric-spark" aria-hidden="true">↗</span>
        </div>
        <strong class="metric-value"><c:out value="${metric.value}"/></strong>
        <span class="badge badge-${metric.tone} badge-soft"><c:out value="${metric.change}"/></span>
      </div>
    </article>
  </c:forEach>
</div>
